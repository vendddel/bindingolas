<Window x:Class="bindingolas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:bindingolas"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" Text="{Binding Text, UpdateSourceTrigger =PropertyChanged}"/>
        <Label Grid.Row="1" Content="{Binding Text}" Background="{Binding SelectedColor}"/>


        <ComboBox Grid.Row="2" SelectedValue="{Binding SelectedColor}" SelectedValuePath="Content">
            <ComboBoxItem Content="red"/>
            <ComboBoxItem Content="lightblue"/>
            <ComboBoxItem Content="green"/>
        </ComboBox>

        <Label Grid.Row="3" Content="{Binding TextLength}"/>

        <CheckBox Content="Félkövér szöveg" Grid.Row="4" IsChecked="{Binding IsBold}"/>
    </Grid>
</Window>
